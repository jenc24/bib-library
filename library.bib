@article{piochTurbulenceModelingPhysicsInformed2023,
  title = {Turbulence {{Modeling}} for {{Physics-Informed Neural Networks}}: {{Comparison}} of {{Different RANS Models}} for the {{Backward-Facing Step Flow}}},
  shorttitle = {Turbulence {{Modeling}} for {{Physics-Informed Neural Networks}}},
  author = {Pioch, Fabian and Harmening, Jan Hauke and M{\"u}ller, Andreas Maximilian and Peitzmann, Franz-Josef and Schramm, Dieter and El Moctar, Ould},
