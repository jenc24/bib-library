@article{saffmanCollisionDropsTurbulent1956,
  title = {On the Collision of Drops in Turbulent Clouds},
  author = {Saffman, P. G. and Turner, J. S.},
  year = 1956,
  month = may,
  journal = {Journal of Fluid Mechanics},
  volume = {1},
  number = {1},
  pages = {16--30},
  issn = {0022-1120, 1469-7645},
  doi = {10.1017/S0022112056000020},
  urldate = {2026-10-19},
  abstract = {This paper proposes a theory of collisions between small drops in a turbulent fluid which takes into account collisions between equal drops. The drops considered are much smaller than the small eddies of the turbulence and so the collision rates depend only on the dimensions of the drops, the rate of energy dissipation {$\varepsilon$} and the kinematic viscosity               v.               Reasons are given for believing that the collision rate due to the spatial variations of turbulent velocity is shown to be               \$N = 1\textbackslash cdot 30(r\_1+r\_2)\textasciicircum 2n\_1 n\_2(\textbackslash epsilon\textbar v)\textasciicircum\textbraceleft\textbackslash frac \textbraceleft 1\textbraceright\textbraceleft 2\textbraceright\textbraceright\$               , valid for               \$r\_1\textbar r\_2\$               between one and two. A numerical integration has been performed using this expression to show how an initially uniform distribution will change because of collisions. An approximate calculation is then made to take account also of collisions which occur between drops of different inertia because of the action of gravity and the turbulent accelerations.                                         The results are applied to the case of small drops in atmospheric clouds to test the importance of turbulence in initiating rainfall. Estimates of {$\varepsilon$} are made for typical conditions and these are used to calculate the initial rates of collision, the change in mean properties and the rate of production of large drops. It is concluded that the effects of turbulence in clouds of the layer type should be small, but that moderate amounts of turbulence in cumulus clouds could be effective in broadening the drop size distribution in nearly uniform clouds where only the spatial variations of velocity are important. In heterogeneous clouds the collision rates are increased, and the effects due to the inertia of the drop soon become predominant. The effect of turbulence in causing collisions between unequal drops becomes comparable with that of gravity when {$\varepsilon$} is about 2000 cm               2               sec               -3               .},
  copyright = {https://www.cambridge.org/core/terms},
  langid = {english}
}

@article{saffmanLiftSmallSphere1965,
  title = {The Lift on a Small Sphere in a Slow Shear Flow},
  author = {Saffman, P. G.},
  year = 1965,
  month = jun,
  journal = {Journal of Fluid Mechanics},
  volume = {22},
  number = {2},
  pages = {385--400},
  issn = {0022-1120, 1469-7645},
  doi = {10.1017/S0022112065000824},
  urldate = {2026-10-14},
  abstract = {It is shown that a sphere moving through a very viscous liquid with velocity               V               relative to a uniform simple shear, the translation velocity being parallel to the streamlines and measured relative to the streamline through the centre, experiences a lift force 81{$\cdot$}2{$\mu$}               Va               2               k               {$\frac{1}{2}$}               /               v               {$\frac{1}{2}$}               + smaller terms perpendicular to the flow direction, which acts to deflect the particle towards the streamlines moving in the direction opposite to               V               . Here,               a               denotes the radius of the sphere, {$\kappa$} the magnitude of the velocity gradient, and {$\mu$} and               v               the viscosity and kinematic viscosity, respectively. The relevance of the result to the observations by Segr\'ee \& Silberberg (1962) of small spheres in Poiseuille flow is discussed briefly. Comments are also made about the problem of a sphere in a parabolic velocity profile and the functional dependence of the lift upon the parameters is obtained.},
  copyright = {https://www.cambridge.org/core/terms},
  langid = {english}
}

