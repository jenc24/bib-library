@article{catalanEffectsNasalCavity2024,
  title = {Effects of {{Nasal Cavity}} and {{Exhalation Dynamics}} on {{Aerosol Spread}} in {{Simulated Respiratory Events}}},
  author = {Catal{\'a}n, Nicol{\'a}s and Cito, Salvatore and Varela, Sylvana and Fabregat, Alexandre and Vernet, Anton and Pallar{\`e}s, Jordi},
