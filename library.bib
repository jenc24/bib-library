@article{gaiDynamicsWakesFreely2024,
  title = {On the {{Dynamics}} and {{Wakes}} of a {{Freely Settling Platonic Polyhedron}} in a {{Quiescent Newtonian Fluid}}},
  author = {Gai, Guodong and Wachs, Anthony},
  year = 2024,
  month = apr,
  journal = {Journal of Fluid Mechanics},
  volume = {985},
  pages = {A3},
  issn = {0022-1120, 1469-7645},
  doi = {10.1017/jfm.2024.269},
  urldate = {2025-05-13},
  abstract = {We investigate systematically the free settling of a single Platonic polyhedron in an unbounded domain filled with an otherwise quiescent Newtonian fluid. We consider a particle--fluid density mimicking a rock in water. Five Platonic polyhedrons of increasing sphericity are studied for a range of Galileo numbers \textbackslash 10 \textbackslash textbackslash leqslant \textbackslash textbackslash mathcal \textbackslash textbraceleft G\textbackslash textbraceright a \textbackslash textbackslash leqslant 300\textbackslash{} . We construct a regime map in the parameter space of Galileo number and particle volume fraction ( \textbackslash textbackslash mathcal \textbackslash textbraceleft G\textbackslash textbraceright a, \textbackslash textbackslash phi\textbackslash{} ), highlighting how the angularity of the Platonic polyhedron impacts its settling path and the onset of instabilities. We find that the initial angular position solely affects the transient settling process. All the Platonic polyhedrons maintain a stable settling angular position at low \textbackslash textbackslash mathcal \textbackslash textbraceleft G\textbackslash textbraceright a\textbackslash{} . Higher angularity leads to path unsteadiness at lower \textbackslash textbackslash mathcal \textbackslash textbraceleft G\textbackslash textbraceright a\textbackslash{} . Path instability progresses from steady vertical to unsteady vertical, followed by oblique settling observed for highly spherical particles, but helical settling (HS) for more angular particles. The particle autorotation is found to be the pivotal factor influencing path instability and the regime transition of angular particles. Beginning in the unsteady oblique and helical regimes, particle autorotation becomes more prevalent, escalating further in the chaotic regime as \textbackslash textbackslash mathcal \textbackslash textbraceleft G\textbackslash textbraceright a\textbackslash{} increases. The particle angular velocity vector is shown to be predominantly situated in the horizontal plane. A thorough force balance in the horizontal plane reveals that the Magnus force is the primary driving force of the HS regime. Additionally, we establish two new empirical correlations to predict the particle settling velocity and the disturbed wake length that solely require the physical properties of the system ( \textbackslash textbackslash mathcal \textbackslash textbraceleft G\textbackslash textbraceright a\textbackslash{} and \textbackslash textbackslash phi\textbackslash{} ). Our numerical results suggest that an increase of the density ratio from \textbackslash 2\textbackslash{} to \textbackslash 3\textbackslash{} exerts only a marginal impact on the path instability of the most angular particle, the settling tetrahedron.},
  file = {/home/nejcv/Zotero/storage/BRW9HR38/Gai and Wachs - 2024 - On the dynamics and wakes of a freely settling Platonic polyhedron in a quiescent Newtonian fluid.pdf}
}

