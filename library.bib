@article{devannaMultiObjectiveRANSAerodynamic2022,
  title = {Multi-{{Objective RANS Aerodynamic Optimization}} of a {{Hypersonic Intake Ramp}} at {{Mach}} 5},
  author = {De Vanna, Francesco and Bof, Danilo and Benini, Ernesto},
  year = 2022,
