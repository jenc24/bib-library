@article{hohneCFDSimulationAeration2020,
  title = {{{CFD Simulation}} of {{Aeration}} and {{Mixing Processes}} in a {{Full-Scale Oxidation Ditch}}},
  author = {H{\"o}hne, Thomas and Mamedov, Tural},
