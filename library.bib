@article{brockParticleGrowthPlumes2002,
  title = {Particle Growth in the Plumes of Coal-fired Power Plants},
  author = {Brock, Charles A. and Washenfelder, Rebecca A. and Trainer, Michael and Ryerson, Thomas B. and Wilson, J. Charles and Reeves, J. Michael and Huey, L. Gregory and Holloway, John S. and Parrish, David D. and H{\"u}bler, Gerhard and Fehsenfeld, Fred C.},
